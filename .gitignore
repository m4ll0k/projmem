# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Build output
build/
dist/
*.whl
# Exception: the UI bundle MUST be committed so pip-installed users
# get a working `projmem ui` without a Node toolchain. Source +
# package.json under projmem/ui/ are tracked; node_modules/ isn't.
!projmem/ui/dist/
!projmem/ui/dist/**

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# projmem's own runtime state — NEVER commit. .projmem/ holds the
# SQLite index plus every note / lease / critical / exclude you've
# authored. It's strictly local; recreate on any machine with
# `projmem init && projmem index`.
.projmem/
*.projmem-pack.json

# Per-operator Claude Code state. The PreToolUse + PostToolUse
# scripts under .claude/hooks/ are operator-specific (paths to
# `projmem`, the bundled README's "settings.json" hint, …). Leave
# the decision to commit them to each repo's owner.
.claude/

# TypeScript / Vite incremental build caches
*.tsbuildinfo
projmem/ui/vite.config.d.ts
projmem/ui/vite.config.js

# Benchmarks live entirely outside the public repo — dev-only
# scaffolding (drivers, graders, raw transcripts) that would
# distract from the product. Local checkouts can still keep a
# bench/ tree; it just won't be tracked.
bench/
/tmp/memtrace_bench/

examples/

# projmem's own output
projmem-out/

# Notebook checkpoints
.ipynb_checkpoints/

# Repo-local backups
*.bak
